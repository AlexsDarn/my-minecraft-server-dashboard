# Nombre del contenedor del servidor de Minecraft
MC_CONTAINER=maincra2
# Host:puerto para mcstatus (query del servidor, no RCON)
MC_HOST=localhost
MC_PORT=25565
# Rutas en el HOST (usadas por backup_service para tar)
MC_DATA_DIR=/opt/minecraft/data
MC_BACKUP_DIR=/opt/minecraft/backups
# Comando RCON dentro del contenedor (itzg/minecraft-server trae rcon-cli)
RCON_CMD=rcon-cli
# IPs/redes permitidas para /admin (coma separada, soporta CIDR)
ADMIN_ALLOW=127.0.0.1/32,::1/128,192.168.0.0/16,10.0.0.0/8,100.64.0.0/10
# Si hay proxy delante (nginx/caddy), ponlo en true y configura la IP del proxy
TRUST_PROXY=false
